SECRET_KEY=
DATABASE_URL=

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Comma-separated allowed browser origins.
# Local dev: leave as-is. Server: set your public origin, e.g.
# https://fes.example.com (not needed when nginx proxies /api same-origin).
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

FLASK_ENV=development

# Password-reset email (SMTP). Gmail: use a 16-character App Password
# (without spaces). Leave username/password empty to disable sending.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Faculty Evaluation System

# Public frontend base URL used inside reset links (no trailing slash).
# Local dev: http://127.0.0.1:5500   Server: https://headwaters-fes.tech
FRONTEND_BASE_URL=

# Sentiment model source. Local dev: leave empty (uses backend/nlp/models/xlmr-finetuned).
# Server: set MODEL_HF_ID to the private Hub repo and HF_TOKEN with read access.
MODEL_PATH=
MODEL_HF_ID=maryjoy1228/fes-xlmr-finetuned
HF_TOKEN=

# Seed-time bootstrap accounts (backend/seed.py). Change these before the
# first real deployment; they are only applied when no admin/hr exists yet.
DEFAULT_ADMIN_USERNAME=admin-jane
DEFAULT_ADMIN_PASSWORD=Secret123!
DEFAULT_HR_USERNAME=hr-bob
DEFAULT_HR_PASSWORD=HrPass1!